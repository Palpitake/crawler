# MySQL RAG backend. RAG is fail-open by default: crawler execution continues
# when the database is temporarily unavailable.
RAG_BACKEND=mysql
RAG_FAIL_OPEN=true
RAG_DUAL_WRITE_JSONL=false

RAG_MYSQL_HOST=127.0.0.1
RAG_MYSQL_PORT=3306
RAG_MYSQL_DATABASE=crawler_rag
RAG_MYSQL_USER=crawler_rag_app
RAG_MYSQL_PASSWORD=change_me
RAG_MYSQL_CHARSET=utf8mb4
RAG_MYSQL_POOL_SIZE=6
RAG_MYSQL_POOL_RECYCLE_SECONDS=1800
RAG_MYSQL_CONNECT_TIMEOUT_SECONDS=5
RAG_MYSQL_READ_TIMEOUT_SECONDS=10
RAG_MYSQL_WRITE_TIMEOUT_SECONDS=10

RAG_ENABLE_FULLTEXT=true
RAG_TOP_K_SITE=5
RAG_TOP_K_STRATEGY=8
RAG_TOP_K_FAILURE=5
RAG_CANDIDATE_LIMIT=80
RAG_SCHEMA_VERSION=1
